# ---- Runtime ----
# NODE_ENV n'est volontairement PAS défini ici : Vite lit ce fichier partagé
# (via envDir) et un NODE_ENV=development y force un « development build »
# React, y compris pendant `vite build`. Le serveur, lui, retombe sur
# "development" par défaut (PGlite locale). En production, définir
# NODE_ENV=production dans l'environnement d'exécution, jamais dans ce fichier.

# ---- Server ----
PORT=4000
# Exact origin allowed for CORS. Cookies require an exact origin, never "*".
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Production: PostgreSQL connection string (reserved for the production driver).
DATABASE_URL=postgresql://user:password@localhost:5432/findbarber
# Local/tests: directory where PGlite persists data (in-memory when empty).
PGLITE_DATA_DIR=./data/pglite
# Optional driver override ("pglite" | "postgres"). Leave empty to infer from
# NODE_ENV (postgres in production, pglite otherwise). Set to "postgres" to use
# PostgreSQL without enabling production-only behavior (Secure cookies, HSTS).
DB_DRIVER=

# ---- Uploads (avatars, galerie) ----
# Répertoire racine des fichiers uploadés, servis sous /uploads. Relatif au
# répertoire d'exécution. En Docker : /app/data/uploads (volume `uploads`).
UPLOAD_DIR=./data/uploads

# ---- Auth ----
# Generate a random secret (>= 32 chars):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# Durée de session en secondes — 604800 = 7 jours
JWT_EXPIRES_IN_SECONDS=604800

# ---- Vérification d'email (Mission A) ----
# Origine du SPA utilisée pour construire le lien de vérification envoyé par
# email. Jamais un secret ; en dev, c'est le serveur Vite.
FRONTEND_URL=http://localhost:5173
# Expéditeur affiché dans l'email de vérification (faux mailer local par défaut).
EMAIL_FROM=FindBarber <no-reply@findbarber.local>
# Durée de validité d'un lien de vérification, en secondes — 86400 = 24 h.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Cooldown minimal entre deux renvois pour un même compte, en secondes.
EMAIL_RESEND_COOLDOWN_SECONDS=60
# Rate limiting du renvoi (bucket IP) et de la consommation du jeton.
EMAIL_RESEND_RATE_LIMIT_WINDOW_MS=600000
EMAIL_RESEND_RATE_LIMIT_MAX=5
EMAIL_VERIFY_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFY_RATE_LIMIT_MAX=20
# --- Provider email réel : NON encore branché (faux mailer log actif). ---
# Réservés pour une évolution future ; le serveur ne lit PAS ces variables
# aujourd'hui. Ne jamais mettre de secret réel dans ce fichier.
# EMAIL_PROVIDER=log
# RESEND_API_KEY=

# ---- Reverse proxy / trust proxy ----
# Nombre de hops de proxy de confiance (optionnel, entier positif).
# Laisser vide = aucun trust proxy (défaut sûr, jamais `true`).
# Ex. 1 derrière Nginx/Render.
TRUST_PROXY_HOPS=

# ---- Rate limiting (anti-brute-force) ----
# Buckets distincts : login court (anti brute-force), inscription moyen,
# mutations sensibles global (réservations + gestion barber).
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=600000
REGISTER_RATE_LIMIT_MAX=5
MUTATION_RATE_LIMIT_WINDOW_MS=900000
MUTATION_RATE_LIMIT_MAX=60

# ---- Géocodage serveur (prestations AT_CLIENT) ----
# Clé API MapTiler côté SERVEUR (secret : jamais exposée au navigateur, jamais
# dans le code client). Utilisée pour géocoder l'adresse du client et vérifier
# qu'elle est dans la zone d'intervention (travel_radius_km) du professionnel.
# Laisser vide : géocodage indisponible, réservations AT_CLIENT refusées.
MAPTILER_GEOCODING_API_KEY=

# ---- Client (Vite) ----
VITE_API_URL=http://localhost:4000

# ---- Carte (MapLibre GL JS + MapTiler) ----
# Clé PUBLIQUE MapTiler, visible dans le navigateur : ce n'est PAS un secret.
# À restreindre via "Allowed HTTP origins" dans le compte MapTiler
# (ex. http://localhost:5173 en développement, puis le domaine de production).
# Ne jamais placer ici un service token ni un token d'administration.
VITE_MAP_API_KEY=
# Style clair/désaturé (catalogue MapTiler, familles Basic/Dataviz).
# Identifiants vérifiés sur le catalogue MapTiler : dataviz-v4 (défaut, Dataviz),
# base-v4 (Basic). `dataviz-v4-light` n'existe pas.
VITE_MAP_STYLE_ID=dataviz-v4
# Optionnel : URL de style complète (style personnalisé), prioritaire si renseignée.
VITE_MAP_STYLE_URL=
# Optionnel : URL de style MapLibre COMPLÈTE pour le thème sombre.
# Laisser vide → la carte conserve exactement le style clair existant, même en
# dark mode (aucune erreur, aucun écran blanc). Aucune clé/URL réelle ici.
VITE_MAP_STYLE_DARK_URL=

# ---- Docker (docker-compose.yml uniquement) ----
# Lues par `docker compose` pour la démo locale ; ignorées par `npm run dev`.
# JWT_SECRET (section Auth) est OBLIGATOIRE pour `docker compose up`.
# Identifiants PostgreSQL du conteneur `db` (défaut : findbarber). La base
# n'est pas exposée hors du réseau Docker ; changer le mot de passe malgré tout
# pour tout environnement partagé.
POSTGRES_USER=findbarber
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=findbarber
# Port publié par Nginx sur l'hôte et origine publique correspondante
# (utilisée pour CORS et les liens de vérification d'email).
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
